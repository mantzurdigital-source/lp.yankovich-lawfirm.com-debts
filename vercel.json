{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/Debts/thank-you",
      "destination": "/thank-you.html"
    },
    {
      "source": "/thank-you",
      "destination": "/thank-you.html"
    },
    {
      "source": "/Debts",
      "destination": "/"
    },
    {
      "source": "/Debts/:path*",
      "destination": "/:path*"
    }
  ]
}
